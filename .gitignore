# dependencies / build artifacts (target must match at ANY depth: app/src-tauri/target)
node_modules/
**/src-tauri/target/
app/dist/
dist/
dist-backend/
build/
*.pyc
__pycache__/
.pytest_cache/
.vite/

# packaging: downloaded/built binaries, staged sidecar
vendor/
app/src-tauri/backend/

# research process notes and captures stay local (never published)
_research/

# local logs
*.log

# editable-install metadata (regenerated by pip install -e .)
src/*.egg-info/
